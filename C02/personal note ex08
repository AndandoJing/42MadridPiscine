• Create a function that converts every letter to lowercase.
• Here is how it should be prototyped:
char *ft_strlowcase(char *str);
• It should return str.

***********

my try:
char    *ft_strlowcase(char *str)
{       
        int     i;
        
        i = 0;
        while (str[i] != '\0')
        {       
                if (str[i] >= 'A' && str[i] <= 'Z')
                {       
                        str[i] = str[i] - 'A' + 'a';
                }       
                i++;
        }       
        return (str);
}       

#include <stdio.h>

int     main(void)
{       
        char    str[7];
        
        str[0] = 'A';
        str[1] = '0';
        str[2] = 'b';
        str[3] = '&';
        str[4] = '\n';
        str[5] = '\0';
        printf("Before: '%s'.\n", str);
        printf("After: '%s'.\n", ft_strlowcase(str));
        return (0);
}  
