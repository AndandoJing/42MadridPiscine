ft_strupcase
Turn-in directory: ex07/
Files to turn in: ft_strupcase.c
Allowed functions: None
• Create a function that converts every letter to uppercase.
• Here is how it should be prototyped:
char *ft_strupcase(char *str);
• It should return str.

*********

char    *ft_strupcase(char *str)
{       
        int     i;
        
        i = 0;
        while (str[i] >= 'a' || str[i] <= 'z') -----------old friend, should be &&. One more thing, we didn't check the '\0'
        {       
                str[i] = str[i] - 'a' + 'A';
                i++;
        }       
        return (str);
}       

#include <stdio.h>

int     main(void)
{       
        char    str[7];
        
        str[0] = 'a';
        str[1] = '1';
        str[2] = 'B';
        str[3] = 'c';
        str[4] = ' ';
        str[5] = '\n';
        str[6] = '!';
        printf("Original: '%s'.\nNow: '%s'.", str, ft_strupcase(str));
        return (0);
}


