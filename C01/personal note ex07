Modifition version 1:
void  ft_rev_int_tab(int *tab, int size)
{
  int  temp;
  int  left;
  int  right;

  left = 0;
  right = size - 1;
  while (left < right)
  {
    temp = tab[left];
    tab[left] = tab[right];
    tab[right] = temp;
    left++;
    right--;
  }
}

#include <stdio.h>
int  main(void)
{
  int  tab[5] = {1, 2, 3, 4, 5};
  int  i = 0;

  printf("before: ");
  while (i < 5)
  {
    printf("%d\n", tab[i]);
    i++;
  }
  printf("\n");

  ft_rev_int_tab(tab, 5);

  printf("after: ");
  i = 0;
  while (i < 5)
  {
    printf("%d ", tab[i]);
    i++;
  }
  printf("\n");
  return (0);
}

