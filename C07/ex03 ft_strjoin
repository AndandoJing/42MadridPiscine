char    *ft_strjoin(int size, char **strs, char *sep)
{
        int             i;
        int             j;
        int             k;
        int             total_len;
        char    *result;

        if (size == 0)
        {
                result = malloc(sizeof(char));
                if (!result)
                        return (0);
                result[0] = '\0';
                return (result);
        }
        i = 0;
        total_len = 0;
        while (i < size)
        {
                total_len = total_len + ft_strlen(strs[i]);
                i++;
        }
        total_len = total_len + ft_strlen(sep) * (size - 1);
        result = malloc (sizeof(char) * (total_len + 1));
        if (!result)
                return (0);
        i = 0;
        k = 0;
        while (i < size)
        {
                j = 0;
                while (strs[i][j] != '\0')
                {
                        result[k] = strs[i][j];
                        j++;
                        k++;
                }
                if (i != size - 1)
                {
                        j = 0;
                        while (sep[j] != '\0')
                        {
                                result[k] = sep[j];
                                j++;
                                k++;
                        }
                }
                i++;
        }
        result[k] = '\0';
        return (result);
}

