• Create a function that returns the next prime number greater than or equal to the
given number.
• The function should be prototyped as follows:
int ft_find_next_prime(int nb);
***********
int	ft_is_prime(int nbr)
{
	int	i;

	i = 2;
	if (nbr <= 1)
		return (0);
	while (i <= nbr / i)
	{
		if (nbr % i == 0)
			return (0);
		i++;
	}
	return (1);
}

int	ft_find_next_prime(int nb)
{
	while (ft_is_prime(nb) == 0)
		nb++;
	return (nb);
}
