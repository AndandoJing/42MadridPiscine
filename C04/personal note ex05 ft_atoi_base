int     ft_check_base(char *base)
{
        int     i;
        int     j;
        int     base_length;

        i = 0;
        while (base[i] != '\0')
                i++;
        base_length = i;
        if (i < 2)
                return (0);
        i = 0;
        while (base[i] != '\0')
        {
                if (base[i] == '+' || base[i] == '-' ||
                        base[i] == ' ' || (base[i] >= 9 && base[i] <= 13))
                        return (0);
                j = i + 1;
                while (base[j] != '\0')
                {
                        if (base[i] == base[j])
                                return (0);
                        j++;
                }
                i++;
        }
        return (base_length);
}

int     ft_base_index(char c, char *base)
{
        int     i;

        i = 0;
        while (base[i] != '\0')
        {
                if (c != base[i])
                        i++;
                else
                        return (i);
        }
        return (-1);
}

int     ft_atoi_base(char *str, char *base)
{
        int     i;
        int     sign;
        int     result;
        int     digit;
        int     base_len;

        i = 0;
        sign = 1;
        result = 0;
        base_len = ft_check_base(base);
        if (base_len == 0)
                return (0);
        while (str[i] == ' ' || (str[i] >= 9 && str[i] <= 13))
                i++;
        while (str[i] == '-' || str[i] == '+')
        {
                if (str[i] == '-')
                        sign = -sign;
                i++;
        }
        digit = ft_base_index(str[i], base);
        while (digit != -1)
        {
                result = result * base_len + digit;
                i++;
                digit = ft_base_index(str[i], base);
        }
        return (sign * result);
}

