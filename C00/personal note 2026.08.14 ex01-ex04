So we may create something like this:
#include <unistd.h>

void	ft_is_negative(int n);

int	main(int argc, char **argv)
{
	int	i;
	int	result;
	int	sign;

	// 如果用户没传参数或传太多，直接退出
	if (argc != 2)
		return (1);

	i = 0;
	sign = 1;
	result = 0;

	// 检查负号
	if (argv[1][0] == '-')
	{
		sign = -1;
		i = 1;  // 从第二个字符开始读数字
	}

	// 遍历每个数字字符，转成整数
	while (argv[1][i] >= '0' && argv[1][i] <= '9')
	{
		result = result * 10 + (argv[1][i] - '0');
		i++;
	}

	// 应用符号
	result = result * sign;

	// 调用你的函数！
	ft_is_negative(result);

	return (0);
}



