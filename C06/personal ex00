#include <unistd.h>

void    ft_print_program_name(char **argv)
{       
        int     i;
        
        i = 0;
        while (argv[0][i] != '\0')
        {
                write(1, &argv[0][i], 1);
                i++;
        }
        write(1, "\n", 1);
}       

int     main(int argc, char **argv)
{       
        (void)argc;
        ft_print_program_name(argv);
        return (0);
