unsigned int    ft_strlcat(char *dest, char *src, unsigned int size)
{
        unsigned int    i;
        unsigned int    j;
        unsigned int    k;

        i = 0;
        j = 0;
        k = 0;
        while (i < size && dest[i] != '\0')
                i++;
        while (src[j] != '\0')
                j++;
        if (i == size)
                return (size + j);
        while (src[k] != '\0' && (i + k < size - 1))
        {
                dest[i + k] = src[k];
                k++;
        }
        dest[i + k] = '\0';
        return (i + j);
}
