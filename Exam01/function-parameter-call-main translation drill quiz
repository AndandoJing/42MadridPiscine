Summary rule:
Definition: TYPE + NAME
Call: pass actual value/variable, no type

int n:
  n -> int
  &n -> int *
char c:
  c -> char
  &c -> char *
char *str:
  str -> char *
  char * -> str
char **argv:
  argv -> char **
  argv[1] -> char *
  argv[1][0] -> char
  &argv[1][0] -> char *

& ----- *
        &                    &
int ___________ -> int * _________ -> int **
    <- ________       <- _________
          *                    *
which means: 
&: one more pointer
*: one less pointer

int  n;
n -> int
&n -> int *

int  *p;
p -> int *
*p -> int

