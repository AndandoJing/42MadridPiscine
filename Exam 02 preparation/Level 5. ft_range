Assignment name: ft_range
Expected file: ft_range.c
Allowed functions: malloc

Write the following function:

int	*ft_range(int start, int end);

It must allocate with malloc() an array of integers, fill it with consecutive values beginning at start and ending at end (including both start and end), then return a pointer to the first value of the array.

Examples:

1, 3   → [1, 2, 3]
-1, 2  → [-1, 0, 1, 2]
0, 0   → [0]
0, -3  → [0, -1, -2, -3]

-----------------------
int	*ft_range(int start, int end)
{
	int	*result;
	int	size;
	int	i;

	i = 0;
	if (start <= end)
		size = end - start + 1;
	else
		size = start - end + 1;

	result = malloc(sizeof(int) * size);
	if (result == NULL)
		return (0);

	if (start <= end)
	{
		while (i < size)
		{
			result[i] = start;
			start++;
			i++;
		}
	}
	else
	{
		while (i < size)
		{
			result[i] = start;
			start--;
			i++;
		}
	}
	return (result);
}
