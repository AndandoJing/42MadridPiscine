
int     ft_atoi(char *str)
{
        int     i;
        int     sign;
        int     result;

        i = 0;
        sign = 1;
        result = 0;
        while (str[i] == ' ' || (str[i] <= 13 && str[i] >= 9))
                i++;
        while (str[i] == '+' || str[i] == '-')
        {
                if (str[i] == '-')
                        sign = -sign;
                i++;
        }
        while (str[i] <= '9' && str[i] >= '0')
        {
                result = result * 10 + (str[i] - '0');
                i++;
        }
        return (sign * result);
}
