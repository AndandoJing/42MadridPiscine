Level 3. last_word
./last_word "   hello wonderful world   "
output: last word
example: "world"

void    ft_lastword(int argc, char **argv)
{       
        int     i;
        
        i = 0;
        if (argc != 2)
        {       
                write(1, "\n", 1);
                return (0);
        }       
        while (argv[1][i] != '\0')
                i++;
        i = i - 1;
        while (argv[1][i] == ' ' || argv[1][i] == '\t')
                i--;
        while (i >= 0 && argv[1][i] != ' ' || (argv[1][i] != '\t'))
                i--;
        i = i + 1;
        while (argv[1][i] != ' ' &&  argv[1][i] != '\t'
                        && argv[1][i] != '\0')
        {
                write(1, &argv[1][i], 1);
                i++;
        }
        write(1, "\n", 1);
        return (0);
} 
