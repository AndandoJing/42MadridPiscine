nested loop非常重要的思维
outer index（外层索引）固定一个目标，inner index（内层索引）围绕这个目标进行搜索。

#include <unistd.h>

int     main(int argc, char **argv)
{       
        int     i;
        int     j;
        int     k;
        
        i = 0;
        if (argc != 3)
        {
                write(1, "\n", 1);
                return (0);
        }
        while (argv[1][i] != '\0')
        {       
                j = 0;
                while (argv[2][j] != '\0' && argv[2][j] != argv[1][i])
                        j++;
                k = 0;
                while (k < i && argv[1][k] != argv[1][i])
                        k++;    
                if (argv[2][j] == argv[1][i] && k == i)
                        write(1, &argv[1][i], 1);
                i++;
        }       
        write(1, "\n", 1);
        return (0);
} 

