ft_strrev
char	*ft_strrev(char *str);
目标是直接修改原string，把它reverse（反转），然后return str。

char    *ft_strrev(char *str)
{
        int             left;
        int             right;
        char    temp;

        right = 0;
        while (str[right] != '\0')
                right++;
        left = 0;
        right = right - 1;
        while (left < right)
        {
                temp = str[left];
                str[left] = str[right];
                str[right] = temp;
                right--;
                left++;
        }
        return (str);
}
