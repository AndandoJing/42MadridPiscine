rot_13
每个alphabetic character（字母字符）向后移动13位，而且要在自己的大小写范围内循环。
example
a → n
b → o
m → z
n → a
o → b
z → m

A → N
N → A

1 → 1
! → !
space → space

#include <unistd.h>

int     main(int argc, char **argv)
{
        int     i;

        i = 0;
        if (argc != 2)
        {       
                write(1, "\n", 1);
                return (0);
        }
        while (argv[1][i] != '\0')
        {       
                if (argv[1][i] <= 'z' && argv[1][i] >= 'n')
                        argv[1][i] = argv[1][i] - 13;
                else if (argv[1][i] <= 'Z' && argv[1][i] >= 'N')
                        argv[1][i] = argv[1][i] - 13;
                else if (argv[1][i] <= 'm' && argv[1][i] >= 'a')
                        argv[1][i] = argv[1][i] + 13;
                else if (argv[1][i] <= 'M' && argv[1][i] >= 'A')
                        argv[1][i] = argv[1][i] + 13;
                write(1, &argv[1][i], 1);
                i++;
        }
        write(1, "\n", 1);
        return (0);
}
