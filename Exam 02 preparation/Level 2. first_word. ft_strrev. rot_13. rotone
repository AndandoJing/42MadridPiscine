rotone 规则是每个字母只向后移动1位, 只在本字母表内循环，其他character保持不变

#include <unistd.h>

int     main(int argc, char **argv)
{
        int     i;

        i = 0;
        if (argc != 2)
        {
                write(1, "\n", 1);
                return (0);
        }
        while (argv[1][i] != '\0')
        {
                if (argv[1][i] == 'z' || argv[1][i] == 'Z')
                        argv[1][i] = argv[1][i] - 25;
                else if ((argv[1][i] >= 'a' && argv[1][i] <= 'y')
                        || (argv[1][i] >= 'A' && argv[1][i] <= 'Y'))
                        argv[1][i] = argv[1][i] + 1;
                write(1, &argv[1][i], 1);
                i++;
        }
        write(1, "\n", 1);
        return (0);
}
