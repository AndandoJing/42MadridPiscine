1. input parsing
since we need to read/receive the string input in the terminal as argument, it should be argc[1], because the argc[0] is the program itself.

#include <unistd.h>
int  main(int argc, char **argv)
{
  int  i;

  i = 0;
  if (argc == 2)
  {
    while (argv[1][i] != '\0')
    {
      write(1, &argv[1][i], 1);
      i++;
    }
  }
  return (0);
}

Example:
