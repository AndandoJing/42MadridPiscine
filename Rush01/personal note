#include <unistd.h>

int     main(int argc, char **argv)
{
        int     i;

        i = 0;
        if (argc == 2)
        {       
                while (argv[1][i] != '\0')
                {
                        if (i % 2 == 0)
                        {       
                                if (argv[1][i] < '1' || argv[1][i] > '4')
                                {       
                                        write(1, "error", 5);
                                }
                        }
                        else 
                        {       
                                if (argv[1][i] != ' ')
                                {       
                                        write(1, "error", 5);
                                }
                        }
                        i++;
                }
        }
        return (0);
}


